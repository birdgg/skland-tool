SKLAND_TOKEN=这里填森空岛 data.content
SKLAND_NICKNAME=我的大号
SKLAND_GAME_TYPE=0

# 默认每天北京时间 06:00；可以省略。
SKLAND_SCHEDULE_HOUR=6
SKLAND_SCHEDULE_MINUTE=0

# 可选：如果你已有可用 dId，可以配置它；否则程序会生成并缓存到 ~/.config/skland-tool/device.env。
# SKLAND_DID=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多账号可改用下面格式：
# SKLAND_USER_1_TOKEN=账号1 token
# SKLAND_USER_1_NICKNAME=账号1
# SKLAND_USER_1_GAME_TYPE=0
# SKLAND_USER_2_TOKEN=账号2 token
# SKLAND_USER_2_NICKNAME=账号2
# SKLAND_USER_2_GAME_TYPE=0
